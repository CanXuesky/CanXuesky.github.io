{% assign t = site.data.translations[page.lang] %}
<div class="education-entry">
  <div class="education-heading"><h3>{{ t.school }}</h3><span class="study-period">{{ t.study_period }}</span></div>
  <p class="education-degree">{{ t.college }} · {{ t.degree }}</p>
  <p class="education-major">{{ t.major }}</p>
</div>
